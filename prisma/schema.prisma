// Prisma schema - Cataloguei
// Documentação: https://www.prisma.io/docs
//
// Prisma 7 não aceita mais `url`/`directUrl` no bloco `datasource`.
// A conexão é configurada em `prisma.config.ts` (datasource.url) e no
// runtime via driver adapter em `src/lib/prisma.ts`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

// Segmento/tema visual da loja. Mantém coerência com THEME_SEGMENTS
// em src/lib/themes/types.ts — qualquer adição precisa ser refletida
// nos dois lugares até a Fase 3 unificar a fonte da verdade.
enum StoreThemeSegment {
  DEFAULT
  TECHNOLOGY
  FOOD
  FASHION
  HEALTH
  EDUCATION
  BEAUTY
  SPORTS
  MUSIC
  MINIMAL
  LUXURY
  NATURE
  KIDS
  PET
  AUTOMOTIVE
  ART
}

// ============================================================
// Models
// ============================================================

// User: preparado para a Fase 3 com Better Auth.
// Campos seguem o padrão esperado pelo Better Auth (name, email, image),
// e os relacionamentos `accounts` e `sessions` completam a integração.
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store    Store?
  accounts Account[]
  sessions Session[]

  @@map("users")
}

// Account: contas de autenticação do Better Auth.
// `issuer` (1.7+) é o namespace de identidade (ex: "local:credential",
// "https://accounts.google.com"). Para email/senha sempre é "local:credential".
// `accountId` é o identificador atribuído pelo provider. Para email/senha
// é o próprio `userId`. A chave única (issuer, accountId) evita colisão
// entre providers.
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  issuer                String    @default("local:credential")
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("accounts")
}

// Session: sessões ativas no DB. O cookie só guarda o `token`.
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Verification: tokens de verificação (email, reset de senha, etc.).
// `identifier` é geralmente o email do usuário; `value` é o token.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// Store: representa uma loja/catálogo.
// 1 User → 1 Store no MVP; o relacionamento 1:N pode ser ativado
// depois trocando `store Store?` por `stores Store[]` no User.
model Store {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique // identificador da loja, usado em /[slug]
  description    String?
  logoUrl        String?
  bannerUrl      String?
  whatsapp       String? // formato livre; validação fica na camada da aplicação
  theme          StoreThemeSegment @default(TECHNOLOGY)
  primaryColor   String? // override opcional do tema
  secondaryColor String?
  ownerId        String            @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("stores")
}

// Product: itens do catálogo pertencentes a uma Store.
// `category` fica como String (não enum) para permitir que cada
// loja use suas próprias categorias sem alterar o schema.
// `active` permite desativar sem excluir; `position` controla a
// ordenação no catálogo. `price` em Decimal(10,2) para evitar
// erros de ponto flutuante em moeda.
model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  category    String?
  active      Boolean  @default(true)
  position    Int      @default(0)
  storeId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, category])
  @@map("products")
}
