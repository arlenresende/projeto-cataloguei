# =============================================================================
# Supabase - variáveis de conexão do banco (Prisma + Next.js)
# =============================================================================
#
# Substitua os placeholders pelos valores reais do seu projeto Supabase:
#   1. Acesse https://app.supabase.com e abra seu projeto
#   2. Clique em "Connect" (canto superior) → aba "ORM"
#   3. Copie a "Direct connection" → cole em DIRECT_URL
#   4. Copie a "Transaction pooler" (porta 6543) → cole em DATABASE_URL
#      Adicione "?pgbouncer=true" no final se não estiver lá
#
# Observações:
#   - DIRECT_URL é usada pelo `prisma migrate` (precisa de conexão sem pooler)
#   - DATABASE_URL é usada pelo app em runtime (pooler, mais escalável)
#   - Use a role `prisma` que a doc do Supabase recomenda (mais seguro)
#

# Connection string DIRETA (porta 5432) — usada por migrations e seed
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Connection string do POOLER (porta 6543) — usada pelo app em runtime
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# =============================================================================
# Better Auth - autenticação
# =============================================================================
# Chave usada para assinar cookies/JWTs. Gere com: openssl rand -base64 32
# NUNCA versione o valor real.
BETTER_AUTH_SECRET="cole_aqui_o_resultado_de_openssl_rand_base64_32"

# URL base da app. Em dev: http://localhost:3000
# Em produção: https://seudominio.com
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_TWITTER_HANDLE=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_WHATSAPP=""

# =============================================================================
# Google OAuth - login social
# =============================================================================
# Crie um OAuth Client em https://console.cloud.google.com:
#   1. APIs & Services > Credentials > Create Credentials > OAuth client ID
#   2. Application type: Web application
#   3. Authorized redirect URIs (uma por ambiente):
#        http://localhost:3000/api/auth/callback/google
#        https://seudominio.com/api/auth/callback/google
#   4. Copie "Client ID" e "Client secret" para os campos abaixo.
#
# Sem essas vars, o botão "Entrar com Google" vai falhar
# (a rota /api/auth/sign-in/social retorna 500).
GOOGLE_CLIENT_ID="cole_aqui_o_client_id_do_google"
GOOGLE_CLIENT_SECRET="cole_aqui_o_client_secret_do_google"

# =============================================================================
# Resend - envio de e-mails transacionais
# =============================================================================
# Gere uma API key em https://resend.com/api-keys e configure um remetente
# verificado no Resend antes de testar o fluxo de verificacao de e-mail.
#
# Exemplos de remetente:
#   onboarding@resend.dev   (sandbox / testes iniciais)
#   no-reply@seudominio.com (producao, com dominio verificado)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# =============================================================================
# Supabase Storage - arquivos públicos da aplicação
# =============================================================================
# Configure um bucket público no Supabase Storage para assets da loja.
# O backend usa a service role para enviar/remover arquivos com segurança.
#
# Exemplo de bucket:
#   cataloguei-public-assets
#
# Você encontra:
# - SUPABASE_URL: Settings > API > Project URL
# - SUPABASE_SERVICE_ROLE_KEY: Settings > API > service_role
# - SUPABASE_STORAGE_BUCKET: nome do bucket criado no Storage
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="cataloguei-public-assets"

# =============================================================================
# Stripe - billing recorrente mensal
# =============================================================================
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PREMIUM_PRICE_ID=""
